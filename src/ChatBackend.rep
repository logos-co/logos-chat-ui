class ChatBackend
{
    ENUM ChatStatus {
        Stopped = 0,
        Initialising = 1,
        Online = 2,
        Error = 3
    }

    // A session-log line's severity, as a bit so a set of them is one integer.
    // Named apart from ChatStatus because both enums flatten into one namespace
    // on the QML side.
    ENUM LogLevel {
        LevelDebug = 1,
        LevelInfo = 2,
        LevelWarning = 4,
        LevelError = 8
    }

    PROP(ChatStatus chatStatus READONLY)
    // This account's own address, the string a peer needs to reach it. Fetched
    // once the module comes online, so the view can show it from first paint.
    PROP(QString myAddress READONLY)
    // Short form of myAddress, on the same rule as a roster row's label, and
    // the two-letter form its avatar carries.
    PROP(QString myLabel READONLY)
    PROP(QString myInitials READONLY)
    PROP(QString currentConversationId)
    // The conversation whose messages and roster the models currently hold.
    // Empty while a selection is being loaded, so the view can tell a loaded
    // thread from the rows of the conversation left behind.
    PROP(QString loadedConversationId READONLY)
    // Derived from the current conversation, kept here (not read off the model)
    // because the models reach QML as QtRO replicas that don't proxy the model's
    // Q_INVOKABLE lookups (isGroupFor/displayNameFor/descriptionFor).
    PROP(bool currentIsGroup READONLY)
    PROP(QString currentDisplayName READONLY)
    PROP(QString currentDescription READONLY)
    // The current conversation's avatar identity, on the same rule as the
    // conversation model's rows.
    PROP(QString currentAvatarInitials READONLY)
    PROP(int currentAvatarRamp READONLY)
    // How many members the current conversation has committed; pending invites
    // are listed in memberModel but not counted here. Exposed as a property (not
    // read off memberModel) because the model reaches QML as a QtRO replica
    // whose rowCount() a non-view caller can't rely on.
    PROP(int memberCount READONLY)
    // Members invited into the current group and awaiting its commit.
    PROP(int pendingMemberCount READONLY)
    // The other participant's address in the current direct conversation, empty
    // for a group or while the roster is unknown.
    PROP(QString currentPeerAddress READONLY)

    // The file this session's host is capturing its log into. Assigned by the
    // host at spawn, and empty under a host that captures nothing, which is what
    // leaves the console with nothing to show.
    PROP(QString sessionLogPath)
    PROP(QString sessionLogSizeLabel READONLY)
    // Of the whole session, whether or not the line is still in the model.
    PROP(int logLineCount READONLY)
    PROP(int logErrorCount READONLY)
    // How many of them the current filters leave on screen.
    PROP(int logShownCount READONLY)
    // One entry per domain: its name, how many lines it wrote, and whether the
    // filter is letting them through. A silent domain and a filtered one read
    // differently, which is the whole point of carrying the count.
    PROP(QVariantList logDomains READONLY)
    // Which LogLevels the filter passes, and the text it narrows to.
    PROP(int logLevels READONLY)
    PROP(QString logFilterText READONLY)
    // The newest line written, which is what the status bar rests on to say the
    // log is running.
    PROP(QString logLastLine READONLY)

    SLOT(void createConversation(QString peerAddress))
    SLOT(void createGroupConversation(QString name, QString description))
    SLOT(void addGroupMember(QString conversationId, QString peerAddress))
    SLOT(void sendMessage(QString conversationId, QString content))
    SLOT(void selectConversation(QString conversationId))
    SLOT(void refreshMembers())

    SLOT(void setLogFilter(QString text))
    SLOT(void setLogLevelEnabled(int level, bool enabled))
    SLOT(void setLogDomainEnabled(QString domain, bool enabled))
    // Writes the whole session file, and writes only the lines the filters
    // currently show, to a fixed directory. Each reports where it landed.
    SLOT(void exportSessionLog())
    SLOT(void exportFilteredLog())

    // A message the module refused, so the composer can offer the text back.
    SIGNAL(sendFailed(QString conversationId, QString content))
    SIGNAL(error(QString message))
    SIGNAL(logExported(QString path))
}

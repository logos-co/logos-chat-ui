class ChatBackend
{
    ENUM ChatStatus {
        Disconnected = 0,
        Initializing = 1,
        Initialized = 2,
        Starting = 3,
        Running = 4,
        Stopping = 5
    }

    // State
    PROP(ChatStatus chatStatus READONLY)
    PROP(QString myIdentity READONLY)
    PROP(QString statusMessage READONLY)
    PROP(QString currentConversationId)

    // Mix sender-anonymity.
    //   mixRequired   - persisted Required/None setting; applied on (re)start.
    //   mixActive     - whether the running session is actually routing via mix.
    //   mixReady      - RLN spam-protection is ready.
    //   mixPoolSize   - current number of reachable mix nodes.
    //   minMixPoolSize- minimum healthy pool; sending is blocked below it.
    PROP(bool mixRequired READONLY)
    PROP(bool mixActive READONLY)
    PROP(bool mixReady READONLY)
    PROP(int mixPoolSize READONLY)
    PROP(int minMixPoolSize READONLY)

    // Chat lifecycle
    SLOT(void initChat())
    SLOT(void startChat())
    SLOT(void stopChat())

    // Set the Required/None mix mode. Persisted; takes effect after a restart.
    SLOT(void setMixMode(bool required))

    // Conversations
    SLOT(void createConversation(QString introBundle, QString initialMessage))
    SLOT(void requestMyBundle())

    // Messaging
    SLOT(void sendMessage(QString conversationId, QString content))
    SLOT(void selectConversation(QString conversationId))

    // Signals (backend -> QML)
    SIGNAL(bundleReady(QString bundle))
    SIGNAL(error(QString message))
    SIGNAL(conversationCreated(QString conversationId, QString displayName))
    SIGNAL(messageReceived(QString conversationId, QString sender, QString content, bool isMe))
}
